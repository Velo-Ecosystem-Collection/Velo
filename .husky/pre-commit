#!/usr/bin/env sh
set -e

repo_root="$(git rev-parse --show-toplevel)"
pnpm_bin="$(sh "$repo_root/scripts/resolve-pnpm.sh" \
  /opt/homebrew/bin/pnpm \
  /usr/local/bin/pnpm)"
pnpm_bin_dir="${pnpm_bin%/*}"
case ":${PATH:-}:" in
  *":$pnpm_bin_dir:"*) ;;
  *) PATH="$pnpm_bin_dir${PATH:+:$PATH}"; export PATH ;;
esac

"$pnpm_bin" lint:fix

if ! git diff --quiet -- packages/backend/convex/_generated; then
  printf '%s\n' 'Stage the updated files in packages/backend/convex/_generated before committing.' >&2
  exit 1
fi

VELO_WALLETS_SKIP_CDN_STAGE=1 "$pnpm_bin" build
