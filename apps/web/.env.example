# Copy to apps/web/.env.local and replace deployment-specific placeholders.
# This file is a reference; Next.js loads .env.local, not .env.example.

# Required to connect the web app to its Convex deployment.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Public app and Stellar configuration. NEXT_PUBLIC_* values are browser-visible.
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Optional locally. Set the deployed Testnet contract IDs to enable all project
# registration and PayAccess features. Production requires both IDs.
NEXT_PUBLIC_VELO_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_VELO_PAY_ACCESS_CONTRACT_ID=
VELO_REQUIRE_CONTRACT_IDS=false

# Optional public configuration.
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional override; omit unless using a separately hosted wallet bundle.
# NEXT_PUBLIC_WALLETS_CDN_BASE_URL=https://your-cdn.example/wallets
NEXT_PUBLIC_VELO_BENCHMARK_MARKERS=false

# Page-only maintenance switches. Only the exact value "true" enables a page.
VELO_PAYMENTS_MAINTENANCE=false
VELO_SETTLEMENT_MAINTENANCE=false

# Wallet authentication. Keep private key material server-side. Generate a
# P-256/ES256 key pair; Convex must trust its public JWKS.
VELO_AUTH_JWT_PRIVATE_KEY_PEM=
# Optional separate challenge HMAC secret; defaults to the JWT private key.
VELO_AUTH_CHALLENGE_SECRET=
# Optional stable Stellar auth server seed; otherwise derived from the HMAC key.
VELO_AUTH_SERVER_SECRET=
# Keep the issuer identical to VELO_AUTH_ISSUER in the Convex environment.
VELO_AUTH_ISSUER=http://localhost:3000

# Shared web/Convex secrets. Generate random values and configure the same value
# for each matching variable in the Convex deployment.
VELO_UI_TELEMETRY_INTAKE_SECRET=
VELO_PLAYGROUND_PERSISTENCE_SECRET=
VELO_PLAYGROUND_RATE_LIMIT_SECRET=

# Optional Playground fixture and network overrides.
PLAYGROUND_HELLO_CONTRACT_ID=
PLAYGROUND_HELLO_WASM_HASH=
STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# Set only when using Mainnet Playground simulation.
# STELLAR_MAINNET_RPC_URL=https://your-mainnet-soroban-rpc.example

# Optional web telemetry. Leave disabled unless an OTLP collector is configured.
VELO_OTEL_ENABLED=false
VELO_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
VELO_OTEL_EXPORTER_OTLP_AUTHORIZATION=
VELO_OTEL_SUCCESS_SAMPLE_RATIO=0.1
VELO_OTEL_SERVICE_NAME=velo-web
VELO_RELEASE_VERSION=development
VELO_TELEMETRY_CONSOLE=false
# Standard OTEL_* variables may override the corresponding VELO_OTEL_* values.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=
# OTEL_RESOURCE_ATTRIBUTES=
