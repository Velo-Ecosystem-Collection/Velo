# Create two API keys in the local dashboard at http://localhost:3000.
# Scope one key to In-house and the other to PDAX. Never reuse the same key.
VELO_INHOUSE_API_KEY=tk_live_your_inhouse_32_hex_chars_key_here
VELO_PDAX_API_KEY=tk_live_your_pdax_32_hex_chars_key_here
VELO_ENV=development
# Optional override:
# VELO_BASE_URL=http://localhost:3000

# Testnet Gas sponsorship route. Keep both values server-side.
# Scope this API key to the project whose relayer policy should sponsor calls.
VELO_GAS_API_KEY=tg_test_0123456789abcdef0123456789abcdef
# Replace with a long random token for trusted callers; do not put it in browser code.
VELO_GAS_DEMO_TOKEN=replace_with_a_long_random_token
VELO_GAS_ENV=testnet
# For local development, use VELO_GAS_ENV=development and a loopback URL only:
# VELO_GAS_ENV=development
# VELO_GAS_BASE_URL=http://localhost:3000
