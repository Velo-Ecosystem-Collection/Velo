# Checkout example configuration. These keys are server-only.
# Create two API keys in the local dashboard at http://localhost:3000.
# Scope one key to In-house and the other to PDAX. Never reuse the same key.
VELO_INHOUSE_API_KEY=tk_live_your_inhouse_32_hex_chars_key_here
VELO_PDAX_API_KEY=tk_live_your_pdax_32_hex_chars_key_here
VELO_ENV=development

# Gas example configuration. Keep all three values server-only.
# This is a separate key from the checkout keys above.
VELO_GAS_API_KEY=tk_test_your_gas_32_hex_chars_key_here
VELO_BASE_URL=http://localhost:3000
VELO_GAS_DEMO_TOKEN=replace_with_a_local_terminal_token
