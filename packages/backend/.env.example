# Convex deployment environment reference.
# These values are not loaded from this file by Convex. Configure them in the
# target Convex deployment using its dashboard or `convex env set`.

# Required by Convex wallet authentication. Use the web JWKS endpoint over
# HTTPS, or a data: URI. Convex Cloud cannot fetch localhost URLs.
VELO_AUTH_JWKS=https://your-public-web-origin/api/auth/wallet/jwks
# Must match VELO_AUTH_ISSUER in apps/web/.env.local; defaults to localhost in dev.
VELO_AUTH_ISSUER=http://localhost:3000

# Required backend payment/Stellar configuration.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VELO_PAY_ACCESS_CONTRACT_ID=
# Compatibility fallback only; prefer VELO_PAY_ACCESS_CONTRACT_ID above.
NEXT_PUBLIC_VELO_PAY_ACCESS_CONTRACT_ID=
VELO_STELLAR_NETWORK=testnet
VELO_DEPLOYMENT_ENVIRONMENT=development
# Set for Mainnet billing only.
VELO_MAINNET_USDC_ISSUER=

# Required for PDAX UAT settlement. Use credentials from the PDAX UAT account.
PDAX_UAT_BASE_URL=https://uat.services.sandbox.pdax.ph/api/pdax-api
PDAX_UAT_USERNAME=
PDAX_UAT_PASSWORD=
# Convex site origin only; the callback path and token query are appended by Velo.
PDAX_CALLBACK_URL=https://your-deployment.convex.site
PDAX_WEBHOOK_TOKEN=

# Shared web/Convex secrets. Configure the same random value in both environments.
# Generate values out of band; do not commit real secrets.
VELO_UI_TELEMETRY_INTAKE_SECRET=
VELO_PLAYGROUND_PERSISTENCE_SECRET=
VELO_PLAYGROUND_RATE_LIMIT_SECRET=

# Optional Convex telemetry exporter configuration.
VELO_CONVEX_TELEMETRY_ENABLED=true
VELO_OTEL_EXPORTER_OTLP_ENDPOINT=
VELO_OTEL_EXPORTER_OTLP_AUTHORIZATION=

# Optional Upstash rate-limit backend. Leave unset to use Convex rate-limit storage.
# Configure all three values together when enabling the Upstash backend; the
# scope secret must contain at least 32 bytes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VELO_RATE_LIMIT_SCOPE_SECRET=
VELO_ENABLE_RATE_LIMIT_BENCHMARK=false

# Optional Testnet Gas custody. Configure only through the reviewed custody setup
# and use separate key material and deployment IDs for dev and production.
VELO_GAS_CUSTODY_KEYRING_JSON=
VELO_GAS_CUSTODY_DEPLOYMENT_ID=
VELO_GAS_MANAGED_RELAYER_PROVISIONING_ENABLED=false
VELO_GAS_TESTNET_FALLBACK_RPC_URL=
# Optional legacy manually configured signer registry. Keep seeds private and
# configure this only in the target deployment, never in source control.
VELO_GAS_TESTNET_RELAYER_SIGNERS_JSON=

# Optional authenticated D2 operator readers. Leave unset unless those readers
# are intentionally configured for this deployment.
VELO_GAS_D2_OPERATOR_TOKEN=
VELO_GAS_D2_PROJECT_ID=
VELO_GAS_D2_DEPLOYMENT_NAME=
VELO_GAS_D2_DEPLOYED_SOURCE_COMMIT=
VELO_GAS_D2_HORIZON_URL=https://horizon-testnet.stellar.org
