                                               {
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "web#build": {
      "env": ["VELO_WALLETS_SKIP_CDN_STAGE"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint:fix": {
      "cache": false,
      "inputs": [".oxlintrc.json"]
    },
    "web#lint:fix": {
      "dependsOn": ["@carts1024/velo-sdk#build"],
      "cache": false,
      "inputs": [".oxlintrc.json"]
    },
    "@repo/backend#lint:fix": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": [".oxlintrc.json"]
    },
    "test": {
      "cache": false
    }
  }
}
